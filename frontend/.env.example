# Frontend port (default: 5173)
VITE_PORT=5173

# For local development (separate frontend/backend)
VITE_API_URL=http://localhost:3001

# For Docker/unified mode (leave empty to use relative URLs)
# VITE_API_URL=

# For accessing from another machine on same network
# Replace <BACKEND_MACHINE_IP> with actual IP (e.g., 192.168.1.100)
# VITE_API_URL=http://<BACKEND_MACHINE_IP>:3001
